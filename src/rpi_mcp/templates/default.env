# Hosts are deliberately kept outside the package artifact.
RPI_MCP_RPI5_HOST=
RPI_MCP_RPI5_SSH_USER=pi
RPI_MCP_RPI5_SSH_PORT=22

RPI_MCP_RPI3_HOST=
RPI_MCP_RPI3_SSH_USER=pi
RPI_MCP_RPI3_SSH_PORT=22

# A dedicated key is recommended. Leave empty to use the SSH agent/default lookup.
# RPI_MCP_SSH_IDENTITY_FILE=~/.ssh/id_ed25519_rpi_mcp
# RPI_MCP_KNOWN_HOSTS_FILE=~/.ssh/known_hosts

# Only for Pis whose sudo asks for a password (e.g. Raspberry Pi 5 images).
# It is sent over SSH stdin to `sudo -S`, never on a command line. Prefer a
# scoped NOPASSWD sudoers entry where possible.
# RPI_MCP_RPI5_SUDO_PASSWORD=
# RPI_MCP_RPI3_SUDO_PASSWORD=

RPI_MCP_CONNECT_TIMEOUT_SECONDS=10
RPI_MCP_COMMAND_TIMEOUT_SECONDS=30
RPI_MCP_ENABLE_COMMANDS=0
RPI_MCP_ENABLE_POWER_ACTIONS=0